# CrowdCast AI - Environment Configuration Example
# Copy this file to .env and configure your credentials

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=crowdcast-ai-dev-secret-key-change-in-production

# Database Configuration
DATABASE_PATH=database/database.db

# Traffic Provider Configuration (Preferred: TomTom Traffic API)
# Leave blank to run in clearly-labelled Demonstration / Fallback Mode
TRAFFIC_PROVIDER=tomtom
TOMTOM_API_KEY=

# Optional Weather Provider Configuration (OpenWeatherMap API)
# Weather features are only activated as live inputs when configured
OPENWEATHER_API_KEY=

# Geospatial & Routing Services (OpenStreetMap / Nominatim / Overpass / OSRM)
NOMINATIM_USER_AGENT=CrowdCastAI-LocationIntelligence/1.0
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org

# Crowd-Traffic Fusion Engine Default Weights (Sum = 1.00)
# Note: These are initial demonstration weights, configurable via env or Admin UI
WEIGHT_TRAFFIC_CONGESTION=0.35
WEIGHT_EXPECTED_CROWD=0.30
WEIGHT_HISTORICAL_PATTERNS=0.20
WEIGHT_EVENT_IMPACT=0.15

# Default Admin Credentials (Change in production)
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=crowdcast_admin_2026

